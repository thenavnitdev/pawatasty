PORT=3000

# Supabase (use service_role key — server only, never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Manufacturer PowerServer (from cabinet vendor — optional until you have hardware)
# MANUFACTURER_API_URL=http://localhost:6888

# Host this folder on Render/Railway/VPS — NOT Vercel.

# RabbitMQ (CloudAMQP, Railway add-on, or your own broker)
RABBITMQ_URL=amqp://user:password@host:5672
